# ==========================
# Enable Rewrite Engine
# ==========================
RewriteEngine On

# ==========================
# 1. 301 Permanent Redirects (Fix Broken / Legacy URLs)
# ==========================

# Redirect /home or /home.html to root domain (https://emta.co.in/)
RewriteCond %{THE_REQUEST} /home(\.html)? [NC]
RewriteRule ^home(\.html)?$ / [R=301,L]

# Redirect /index or /index.html to root domain (https://emta.co.in/)
RewriteCond %{THE_REQUEST} /index(\.html)? [NC]
RewriteRule ^index(\.html)?$ / [R=301,L]

# Redirect /job-vacancy or /job-vacancy.html to /recruitment-solution
RewriteRule ^job-vacancy(\.html)?$ /recruitment-solution [R=301,NC,L]

# Redirect old course-structure links to clean course URLs
RewriteRule ^course-structure/(.*)$ /course/$1 [R=301,NC,L]

# ==========================
# 2. Internal Rewrites
# ==========================

# Internal rewrite: translate /course/X to course-details.html?id=X
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^course/([0-9]+)/?$ course-details.html?id=$1 [QSA,NC,L]

# Redirect direct .html requests to clean URLs (e.g. /about.html -> /about)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# Rewrite clean URLs to .html ONLY if the corresponding .html file exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^\.]+)$ $1.html [L]

# ==========================
# 3. Error Handling & Default Document
# ==========================

# Handle 404 errors (Direct unhandled URLs to branded 404 page)
ErrorDocument 404 /404.html

# Set default home page
DirectoryIndex index.html

# ==========================
# Performance Optimizations
# ==========================

# Gzip Compression (HTML, CSS, JS, JSON, XML, Fonts)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml application/font-woff2
</IfModule>

# Browser Caching (Leverage Cache)
<IfModule mod_expires.c>
  ExpiresActive On
  # Images - cache for 1 year
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  # CSS & JS - cache for 1 month
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  # HTML - short cache (must stay fresh)
  ExpiresByType text/html "access plus 600 seconds"
</IfModule>

# Cache-Control headers (extra for safety)
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ==========================
# Security Best Practices
# ==========================
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  # Enable XSS Protection
  Header set X-XSS-Protection "1; mode=block"
  # Prevent framing (Clickjacking)
  Header set X-Frame-Options "SAMEORIGIN"
  # Force HTTPS (if using SSL)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>
