    "prisma:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2"
  }
}
