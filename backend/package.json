{
  "name": "emta-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "prisma:init": "prisma init --datasource-provider mysql --output ../generated/prisma",
